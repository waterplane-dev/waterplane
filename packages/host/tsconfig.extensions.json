{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist/extensions",
    "rootDir": "../extensions",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // a facade that node type stripping loads as source names its slices `.mts`; emit them as `.mjs`
    "rewriteRelativeImportExtensions": true,
    "types": ["node"]
  },
  "include": ["../extensions/*/host/**/*.mts", "../extensions/*/shared/**/*.mts"]
}
