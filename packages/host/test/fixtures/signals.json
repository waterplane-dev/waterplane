      { "path": "permmode/*.txt", "role": "guard", "test": "packages/host/test/trustbox.test.mjs" },
      { "path": "screens/checkbox-*.txt", "role": "match", "test": "packages/host/test/screens.test.mjs", "cli": "2.1.301" },
      { "path": "screens/slash-*.txt", "role": "guard", "test": "packages/host/test/screens.test.mjs", "cli": "2.1.301" },
      { "path": "screens/context-view.txt", "role": "guard", "test": "packages/host/test/screens.test.mjs", "cli": "2.1.301" }
    ],
    "prompt.submit": [
      { "path": "screens/checkbox-*.txt", "role": "match", "test": "packages/host/test/screens.test.mjs", "cli": "2.1.301" }
    ],
    "deliver.echo": [
      { "path": "screens/paste-*.txt", "role": "match", "test": "packages/host/test/screens.test.mjs", "cli": "2.1.301" }
    ],
    "context.meter": [
      { "path": "screens/context-view.txt", "role": "match", "test": "packages/host/test/screens.test.mjs", "cli": "2.1.301" }
    ],
    "slash.local": [
      { "path": "screens/slash-*.txt", "role": "match", "test": "packages/host/test/screens.test.mjs", "cli": "2.1.301" },
      { "path": "screens/context-view.txt", "role": "match", "test": "packages/host/test/screens.test.mjs", "cli": "2.1.301" }
    ],
    "limit.reset": [
      { "path": "screens/slash-usage-*.txt", "role": "guard", "test": "packages/host/test/screens.test.mjs", "cli": "2.1.301" },
      { "path": "screens/context-view.txt", "role": "guard", "test": "packages/host/test/screens.test.mjs", "cli": "2.1.301" },
      { "path": "screens/checkbox-submit.txt", "role": "guard", "test": "packages/host/test/screens.test.mjs", "cli": "2.1.301" }
