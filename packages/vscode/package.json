{
  "name": "waterplane",
  "displayName": "waterplane: Claude Code Usage, Cost & Context (+ Copilot)",
  "publisher": "waterplane-dev",
  "version": "0.9.16",
  "description": "See what each Claude Code prompt cost and why, the context window over time, and what CLAUDE.md costs every request. Copilot usage too. Reads local logs, no telemetry.",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/waterplane-dev/waterplane"
  },
  "homepage": "https://waterplane.dev",
  "engines": {
    "vscode": "^1.90.0"
  },
  "pricing": "Free",
  "bugs": {
    "url": "https://github.com/waterplane-dev/waterplane/issues"
  },
  "galleryBanner": {
    "color": "#12151c",
    "theme": "dark"
  },
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "claude code usage",
    "claude code cost",
    "claude code sessions",
    "usage",
    "cost",
    "tokens",
    "token usage",
    "context window",
    "claude.md",
    "agents.md",
    "subagents",
    "prompt cache",
    "github copilot",
    "copilot usage",
    "copilot quota",
    "premium requests",
    "status bar",
    "statistics"
  ],
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "waterplane.open",
        "title": "Open cost & context",
        "category": "waterplane",
        "icon": "$(link-external)"
      },
      {
        "command": "waterplane.rescan",
        "title": "Re-read Claude Code logs",
        "category": "waterplane",
        "icon": "$(refresh)"
      },
      {
        "command": "waterplane.show",
        "title": "Show a view in the panel",
        "category": "waterplane"
      },
      {
        "command": "waterplane.pickSession",
        "title": "Show a session in the panel",
        "category": "waterplane"
      },
      {
        "command": "waterplane.pickFolder",
        "title": "Switch folder",
        "category": "waterplane"
      },
      {
        "command": "waterplane.copyPrompt",
        "title": "Copy an optimisation prompt",
        "category": "waterplane"
      },
      {
        "command": "waterplane.healthRefresh",
        "title": "Measure repo health from git history",
        "category": "waterplane"
      },
      {
        "command": "waterplane.copilotQuota",
        "title": "Read Copilot's quota from GitHub (asks to sign in)",
        "icon": "$(github)",
        "category": "waterplane"
      },
      {
        "command": "waterplane.copilotQuotaOff",
        "title": "Stop reading Copilot's quota",
        "category": "waterplane"
      },
      {
        "command": "waterplane.openApp",
        "title": "Open waterplane",
        "category": "waterplane",
        "icon": "$(window)"
      },
      {
        "command": "waterplane.openAppInBrowser",
        "title": "Open in browser",
        "category": "waterplane",
        "icon": "$(link-external)"
      },
      {
        "command": "waterplane.reloadApp",
        "title": "Reload the app tab",
        "category": "waterplane",
        "icon": "$(refresh)"
      }
    ],
    "configuration": {
      "title": "waterplane",
      "properties": {
        "waterplane.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the live session's cost and context in the status bar, or the last seven days' cost when no session is live."
        },
        "waterplane.pollSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 2,
          "description": "How often the active session log is re-checked when file watching misses a write."
        },
        "waterplane.claudeConfigDir": {
          "type": "string",
          "default": "",
          "description": "Override the claude CLI's config dir (else CLAUDE_CONFIG_DIR, else ~/.claude)."
        },
        "waterplane.desktopUrl": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Read the live rate-limit windows, budget and other backends' ledgers for All sessions from a waterplane desktop on THIS machine (e.g. http://127.0.0.1:8770). Empty = those readings are off, and Open waterplane looks at http://127.0.0.1:8770. Only a loopback address is ever read."
        },
        "waterplane.healthSeconds": {
          "type": "number",
          "default": 600,
          "minimum": 10,
          "description": "How long one repo-health step (reading git history) may run before it is stopped. Rows measured so far are kept."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "waterplane",
          "title": "waterplane",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "waterplane": [
        {
          "id": "waterplane.sidebar",
          "name": "Cost & context",
          "contextualTitle": "waterplane",
          "icon": "media/activity.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "waterplane.rescan",
          "when": "view == waterplane.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "waterplane.open",
          "when": "view == waterplane.sidebar",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "waterplane.openAppInBrowser",
          "when": "activeWebviewPanelId == 'waterplane.app' && waterplane.appAnswered",
          "group": "navigation"
        },
        {
          "command": "waterplane.reloadApp",
          "when": "activeWebviewPanelId == 'waterplane.app'",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "waterplane.show",
          "when": "false"
        },
        {
          "command": "waterplane.pickSession",
          "when": "false"
        },
        {
          "command": "waterplane.openAppInBrowser",
          "when": "activeWebviewPanelId == 'waterplane.app' && waterplane.appAnswered"
        },
        {
          "command": "waterplane.reloadApp",
          "when": "activeWebviewPanelId == 'waterplane.app'"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "test": "npm run build && node --test --test-timeout=120000 \"test/*.test.mjs\"",
    "test:integration": "node test/integration/run.mjs",
    "screenshots": "node scripts/screenshot.mjs",
    "package": "npm run build -- --release && vsce package --no-dependencies --baseImagesUrl https://raw.githubusercontent.com/waterplane-dev/waterplane/main/packages/vscode -o waterplane-0.9.16.vsix && node scripts/check-vsix.mjs waterplane-0.9.16.vsix",
    "check": "npm run typecheck && npm test && npm run package",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.21",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.1",
    "lucide-react": "1.21.0",
    "ovsx": "1.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "ovsx": {
      "@vscode/vsce": "$@vscode/vsce"
    },
    "@azure/msal-node": "7.1.0",
    "minimatch@^10": "^11.0.1"
  }
}
