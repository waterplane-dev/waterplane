# Supply-chain defaults for this repo (why: docs/notes/testing-and-ops.md#supply-chain).
#
# No dependency runs code at install time. The packages that ask to (node-pty, esbuild,
# fsevents) work from their shipped prebuilds; the one fix-up we need (node-pty's
# spawn-helper exec bit) runs from `npm run build:shared` instead of a postinstall.
ignore-scripts=true
# A version must be a week old before `npm install` will pick it: most hijacked releases
# are caught and pulled within days. `npm ci` installs the lockfile and is unaffected.
min-release-age=7
