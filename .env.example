# waterplane environment — copy to .env (gitignored) and edit. Everything here
# is optional; the defaults shown are what you get if you set nothing.
#
# The host also reads <WATERPLANE_STATE_DIR>/.env and the per-user config dir, so a
# secret can live outside the repo. All three load before any module reads a
# knob (packages/host/src/env.ts). Precedence, highest first: the shell (never
# overwritten by a file), then the per-user config dir (~/.config/waterplane/.env,
# where Settings → set secret writes), then this file, then <WATERPLANE_STATE_DIR>/.env.

# Older names: every knob below was once spelled USMC_<NAME>. Those still work
# (the host reads the new name first, then the old one, and logs once per old
# name it had to fall back to) — rename them in your .env when you see the line.

# ── Where it looks, where it listens ─────────────────────────────────────────

# Directory scanned for git repos and worktrees. EVERYTHING under here is
# reachable from the phone — choose it deliberately. Unset: the first of ~/dev, ~/code, ~/Code,
# ~/src, ~/projects, ~/Projects, ~/repos, ~/git, ~/Developer, ~/workspace, ~/source/repos,
# ~/Documents/GitHub that exists (one holding a repo wins over an empty one); else ~/dev.
# Between the two: a folder chosen on the phone (the one-time "which folder holds your repos?"
# dialog, or Settings → Code folder), kept in <config dir>/root.json (~/.config/waterplane/root.json).
# This variable, when set, wins over that choice.
# Read from the shell, this file or the per-user config file (not <WATERPLANE_STATE_DIR>/.env,
# which it decides). On Windows the host runs inside WSL and a Windows path is taken as its
# WSL mount: WATERPLANE_ROOT=c:/dev means /mnt/c/dev there.
# WATERPLANE_ROOT=/Users/you/dev

# Where the host keeps its OWN state — the ack ledger, sessions, settings, intents,
# push keys, LAN password, device tokens, every ledger. Outside the code root, so
# changing WATERPLANE_ROOT orphans nothing. Default: $XDG_STATE_HOME/waterplane when
# XDG_STATE_HOME is set, else ~/.local/state/waterplane (every platform). A host that
# kept it at <WATERPLANE_ROOT>/.waterplane moves it there once at boot and leaves a
# symlink behind; if both already hold state, what the new one lacks is merged in
# entry by entry, a file both hold stays in the old dir untouched (the new copy is
# used), and the boot log and the doctor's `state` row name it. `waterplane service
# install` bakes the resolved value into the service, so the service and this shell agree. Like WATERPLANE_ROOT this is read from
# the shell, this file or the per-user config file — never from the .env inside it,
# which can only be found once it is known. Per-repo state
# (<repo>/.waterplane/: builds.json, capture.json, …) stays in the repo.
# WATERPLANE_STATE_DIR=/Users/you/.local/state/waterplane

# Windows only: the WSL distro the launcher runs the host in (`npm run restart`/`start`/
# `doctor`/`dev` from a checkout, `waterplane …` from an npm install). Unset: WSL's default distro.
# On the Windows routes the launcher reads WATERPLANE_WSL_DISTRO and WATERPLANE_PORT from the shell,
# then this install's launcher file (%LOCALAPPDATA%\waterplane\launcher-<id>.json — an npm
# install remembers there what its shell set on setup/start/autostart), then (checkout only) this
# repo .env.
# WATERPLANE_WSL_DISTRO=Ubuntu

# HTTP + WebSocket port. (The Windows launcher reads it as WATERPLANE_WSL_DISTRO above says.)
# WATERPLANE_PORT=8770

# Bind address override. Default = Tailscale IP + loopback. The host REFUSES a
# LAN/public bind unless you opt in below (no app auth; the daemon runs code).
# WATERPLANE_HOST=127.0.0.1

# Also bind LAN interfaces, so same-WiFi devices can connect without Tailscale.
# LAN connections are then password-gated (set the password from a trusted
# device in Settings → LAN access). With no password set, LAN is refused.
# WATERPLANE_ALLOW_PUBLIC=1

# The APK the pairing page's "Download the Android app" button serves
# (`/pair/<code>/apk`, valid while the pairing code is). Default: the debug
# build `npm run apk` writes, packages/app/android/app/build/outputs/apk/dev/debug/app-dev-debug.apk;
# the newer of the two wins. May also name a directory (its newest .apk).
# WATERPLANE_APK_PATH=/path/to/waterplane.apk

# How long a pairing code lives, in ms (default and maximum 600000 = 10 min,
# floored at 1000). Only the e2e suite shortens it; codes are memory-only, so a
# host restart invalidates every outstanding one anyway.
# WATERPLANE_PAIR_TTL_MS=600000

# How long a passive device's PIN unlock lasts, in ms (default 1800000 = 30 min,
# capped there, floored at 1000). Only the e2e suite shortens it; an unlock is
# held in the host's memory, so a host restart locks every passive device too.
# WATERPLANE_PASSIVE_UNLOCK_MS=1800000

# Path to the Claude Code binary, if it isn't on PATH as `claude`.
# WATERPLANE_CLAUDE_BIN=claude

# The shell a "shell" session runs (`backends/shell.ts`, started with `-l`).
# Default: your own $SHELL, else /bin/sh. The e2e suite pins /bin/sh.
# WATERPLANE_SHELL_BIN=/bin/zsh

# How often (ms) the daemon asks a backend to reap what a GONE session left behind
# (a backend plugin's per-session server and its record, after its pane died while
# detached or while the daemon was down). Also run once when the plugins have settled.
# A backend extension's own knobs are listed in its README (packages/extensions/<id>/).
# WATERPLANE_SEAT_SWEEP_MS=60000

# How deep the repo scan recurses below WATERPLANE_ROOT.
# WATERPLANE_MAX_DEPTH=3

# ── Same-origin guard ────────────────────────────────────────────────────────
# /api and /ws refuse browser requests whose Origin/Host isn't one we serve on —
# this is what stops a random web page from driving the daemon. Loopback, the
# Tailscale IP, *.ts.net, *.local and any bound LAN IP are allowed already. Add
# to the allowlist only if you reach the host under some other name (a reverse
# proxy, a custom /etc/hosts alias).
# WATERPLANE_ALLOWED_HOSTS=my-proxy.internal,box.home.arpa
# WATERPLANE_ALLOWED_ORIGINS=https://my-proxy.internal
# Also trust the Vite dev server's origin (port 5173). `npm run dev` sets this
# for you; a production daemon should not have it.
# WATERPLANE_DEV=1
# Where `npm run dev` listens: this machine's Tailscale address when it has one
# (the dev UI is then at http://100.x.y.z:5173, not localhost — vite binds one
# address and prints it), else loopback. Name one of those two tiers to choose;
# a Wi-Fi address is refused, because a proxied request would reach the daemon
# as a tailnet-tier caller, trusted without the password.
# WATERPLANE_DEV_HOST=127.0.0.1

# ── Session persistence ──────────────────────────────────────────────────────
# Each claude session runs inside tmux so it survives a host restart LIVE (they
# are re-adopted on boot). tmux is REQUIRED and there is no way round it: a host
# that cannot find tmux refuses to start sessions and `doctor` says how to
# install it. (The old WATERPLANE_TMUX knob is gone; doctor warns it is ignored.)
# Name of the private tmux server used for those sessions (kept separate from
# your own tmux). Only change it if it collides with something.
# WATERPLANE_TMUX_SERVER=waterplane
# How long (ms) a session's record under <state dir>/live/ must have gone unwritten
# before a boot may delete it for having no tmux session left (its pane died while
# the daemon was down). Guards a session whose spawn is still in flight. A knob
# because `e2e-livereclaim.mjs` cannot wait an hour; nothing else should set it.
# WATERPLANE_STALE_LIVE_MIN_AGE_MS=3600000

# ── Turn detection and notifications ─────────────────────────────────────────
# Turn boundaries come from claude's own hooks when available. These thresholds
# are the fallback for sessions where the hook pipe never reports.
# Backlog "idle ≈ turn done" threshold (ms).
# WATERPLANE_IDLE_MS=10000
# Turn-finished push notification threshold (ms).
# WATERPLANE_IDLE_PING_MS=4000
# A Stop hook is the CLI ASKING to end the turn, and a hook may answer no — that
# is how every keep-going loop (a /goal hook, a checklist driver) is built, and
# no UserPromptSubmit follows when it does. So a Stop is settled against the
# screen: the CLI's own working line still printing after it means the turn is
# carrying on. How long each settle pass waits (ms). 0 believes the hook at once.
# WATERPLANE_STOP_VERIFY_MS=1200
# Agents running UNDER a session (the Task/Agent tool) are a separate fact from
# the turn: a background agent outlives the turn that launched it. How often the
# list is re-read while any is running — armed only while there is one (ms).
# WATERPLANE_AGENT_POLL_MS=5000
# How long an agent's log may be quiet and still count as running, when nothing
# in the parent conversation has recorded it as finished. Generous on purpose:
# an agent inside a ten-minute test run writes nothing (ms).
# WATERPLANE_AGENT_STALE_MS=600000
# Background shells (a run_in_background Bash, a Monitor) are read off the
# process table under the CLI's own pid. 0 turns the reader off — SessionInfo
# .shellList then stays absent, same as a ps that failed to run.
# WATERPLANE_SHELLS=1
# How long a shell may go without its CPU moving or its output growing and
# still read as "working", before it reads "waiting"/"quiet" instead (ms).
# WATERPLANE_SHELL_QUIET_MS=600000
# Contact address embedded in the Web Push VAPID keys. Some push services reject
# a non-routable one, so set a real address if notifications misbehave.
# WATERPLANE_VAPID_CONTACT=mailto:you@example.com
# Weekly-limit burn push: when the weekly percentage climbs faster than this many points per
# hour over the last stretch of readings (>= 45 min, reset-aware), push one notification naming
# the dearest session or fan-out in that stretch. Words only; nothing is paused. 0 = off.
# WATERPLANE_BURN_PTS_PER_HOUR=4
# At most one burn push per this many ms, and never twice for one stretch.
# WATERPLANE_BURN_COOLDOWN_MS=10800000
# Week-end burn: at most this many small backlog packages per picked repo per weekly window
# (one live at a time; the next is posted only after the last settles). 0 = post none.
# WATERPLANE_WEEKBURN_MAX_PER_REPO=6

# ── CLI-health record ────────────────────────────────────────────────────────
# How long after a spawn the hook pipe and the conversation log may be missing
# without it counting against them (ms). Both are legitimately absent for the
# first seconds of a session; the default is a minute. Lowered only by
# `e2e-clihealth.mjs`, which cannot wait one out per assertion.
# WATERPLANE_HEALTH_GRACE_MS=60000

# ── Usage-limit auto-continue ────────────────────────────────────────────────
# When a session hits a Claude usage limit, the host resumes it at the reset
# time (or reopens the conversation with --continue if the CLI exited).
# Host-wide hold-off after a resume came back still blocked (ms). With no reset
# instant the WAIT itself is a widening backoff (limitretry.ts), not this.
# WATERPLANE_LIMIT_RETRY_MS=600000
# Grace period after a parsed reset time before retrying (ms).
# WATERPLANE_LIMIT_RESET_BUFFER_MS=120000
# Churn guard: stop after this many attempts on ONE block. It bounds how many
# times the host tries, never how long it waits — the backoff widens to 6h, so
# the default spans a weekly window rather than an afternoon.
# WATERPLANE_LIMIT_MAX_ATTEMPTS=64
# Patience: stop waiting once one block has lasted this long (ms). A weekly
# window is 7 days, so the default is a window and a bit.
# WATERPLANE_LIMIT_GIVEUP_MS=691200000
# How long after a conversation is reopened at a wall it may re-hit that wall and
# still count as the SAME block (ms) — a reopen re-blocks in seconds, and without
# this the count and the patience clock restarted on every one of them.
# WATERPLANE_LIMIT_CARRY_MS=300000
# First rung of the retry backoff (ms). Only the first: the rungs after it are
# fixed (1m, 5m, 30m, 2h, 6h). Shortened by e2e scripts that cannot sit one out.
# WATERPLANE_LIMIT_PROBE_MS=5000
# The whole backoff ladder (ms, comma-separated). Test knob only — a ladder short
# enough to sit out is the flat cadence this replaced.
# WATERPLANE_LIMIT_LADDER_MS=5000,60000,300000,1800000,7200000,21600000
# How often quiet sessions are re-scanned for a limit banner (ms). A session the
# host believes is BLOCKED is re-scanned on this cadence even while it is noisy.
# WATERPLANE_LIMIT_SWEEP_MS=60000
# How long a turn must have been in flight before it counts as proof the account
# is serving this session again, overruling a banner still sitting on screen (ms).
# A rejected turn dies in seconds; anything past this is work.
# WATERPLANE_LIMIT_SERVING_MS=30000

# Resume queue. Several sessions blocked on the SAME limit resume one at a time,
# not all at once. GAP is the breath between two resumes; SETTLE is how long the
# queue waits for a resumed session to show a verdict (turn started / re-blocked)
# before letting the next one go.
# WATERPLANE_LIMIT_RESUME_GAP_MS=8000
# WATERPLANE_LIMIT_RESUME_SETTLE_MS=90000

# ── Gemini key (optional) ────────────────────────────────────────────────────
# Core makes no Gemini call of its own. Used only by a plugin whose manifest
# declares it (a plugin reads only the env names it declares; the phone shows
# set/unset, never the value). The decision oracle is now such a plugin, kept
# outside this repo — see docs/notes/plugins.md. Settable from the phone's
# secret sheet (host scope), which applies live.
# GEMINI_API_KEY=your-aistudio-key            # https://aistudio.google.com/apikey
#
# ── Plugins ──────────────────────────────────────────────────────────────────
# Loaded once at boot from <config dir>/plugins/*/ and the paths listed in
# <config dir>/plugin-paths.json ({"paths": ["~/dev/my-plugin"]}; formerly plugins.json,
# renamed on boot); the config dir is
# WATERPLANE_CONFIG_DIR (default ~/.config/waterplane). No knob of their own.
#
# ── Whole-picture text, on-device (the annotator's "text only") ──────────────
# A photo of another screen, with you in it: the DESKTOP reads every word
# (macOS Vision via a Swift helper compiled once into the state dir; on WSL2 or
# Windows the OS's own Windows.Media.Ocr through powershell.exe; else
# tesseract), the phone shows the text for editing, and ONLY that text is sent.
# The image never reaches the inbox, an agent, or any cloud model.
# WATERPLANE_LOCAL_OCR=0                            # turn it off
#
# ── Dictation (the microphone in the compose bar) ────────────────────────────
# The phone records 16 kHz mono and the DESKTOP transcribes it with whisper.cpp
# — no key, no account, no audio leaving the machine. Measured here: 28.6 s of
# German in 0.95 s (large-v3-turbo, Metal), which is why this is the default
# engine and the browser's own recogniser is only the fallback. Needs
# `brew install whisper-cpp` and a ggml model; the microphone itself needs a
# SECURE CONTEXT, so on a bare http://100.x tunnel the phone falls back.
# WATERPLANE_DICTATE=0                              # kill switch, even with a model installed
# WATERPLANE_WHISPER_BIN=whisper-cli                # the binary, if it is not on PATH
# WATERPLANE_WHISPER_MODEL=~/.local/share/waterplane/models/ggml-large-v3-turbo.bin
#                                             # default: newest ggml-*.bin in that directory
# WATERPLANE_WHISPER_LANG=auto                      # 'auto' detects; pin only to force one language
# WATERPLANE_WHISPER_THREADS=8                      # default: cores-1, capped at 8
# whisperd (~/dev/whisperd) keeps the model resident and is asked FIRST; the
# CLI above is the fallback when it is not running, busy or failing.
# WATERPLANE_WHISPERD_URL=http://127.0.0.1:8777     # 'off' = CLI only
# WATERPLANE_WHISPERD_MODEL=turbo                   # turbo | turbo-q8 | turbo-q5 | small | base
# WATERPLANE_DICTATE_KEEP=1                         # OPT-IN: keep each clip + its text, for benchmarks
# WATERPLANE_DICTATE_KEEP_DIR=~/.local/share/waterplane/dictations
# WATERPLANE_USAGE_TTL_MS=480000                    # usage cache TTL (scrapes /usage)
# WATERPLANE_USAGE_FAIL_TTL_MS=60000                # how long a FAILED probe is believed before another one spawns
# The readings the daemon takes are KEPT, so the two limit windows have a
# history. Nothing is ever scraped for the history itself — see usagelog.ts.
# WATERPLANE_USAGELOG_CAP=5000                      # most readings retained
# WATERPLANE_USAGELOG_RETAIN_MS=2592000000          # …and for how long (30 days)
# WATERPLANE_USAGELOG_REPEAT_MS=1800000             # how long an UNCHANGED reading waits before it is kept anyway
#   (the same three bound every other source's usagelog-<source>.jsonl — usagesourcelog.ts)
# Copilot's quota beside Claude's on the usage chip (packages/extensions/copilot-usage):
# read only when `copilot` is on PATH, with `gh api /copilot_internal/user` (gh's own sign-in).
# WATERPLANE_GH_BIN=gh                              # the gh binary it runs
# A session's OWN budget (sessionbudget.ts): when one is hit, sends to it are
# held and ONE Esc interrupts the running turn — only a hooked, provably running
# turn with no box on screen. 0 = never send the Esc, desktop-wide (the hold and
# the notification still happen; each budget also has its own interrupt switch).
# WATERPLANE_SESSION_BUDGET_INTERRUPT=1
# WATERPLANE_TOKENSTATS_HOUR_DAYS=14                # days of HOURLY token detail put on the wire (the store keeps all of it)

# ── Bandwidth ────────────────────────────────────────────────────────────────
# All three are ON by default and exist so a slow/metered link (roaming, hotel
# WiFi) costs a fraction of the bytes. Turn one off only to debug it.
# Server-made image thumbnails for the gallery grid / image strips. Needs sips
# (macOS, built in), ImageMagick or ffmpeg; without one, originals are served.
# Cached in <state dir>/thumbs.
# WATERPLANE_THUMBS=0
# br/gzip compression of HTTP responses (transcripts, listings, diffs, the app
# bundle).
# WATERPLANE_COMPRESS=0
# permessage-deflate on the WebSocket — the PTY stream is repetitive ANSI and
# compresses roughly an order of magnitude.
# WATERPLANE_WS_COMPRESS=0
# The host pings every socket at the protocol level this often (ms; the
# browser answers by itself). A socket that answers neither of two pings in a
# row is dropped, so a phone that slept or a tailnet that flapped stops being
# counted as somebody watching its sessions within ~40-60 s. 0 = no ping.
# WATERPLANE_WS_PING_MS=20000
# A socket whose send buffer is past this many bytes gets no more terminal
# output; once it drains it gets one full repaint instead of the deltas it
# missed. Bounds host memory for a crawling or dead link. 0 = no limit.
# WATERPLANE_WS_PTY_BACKLOG_BYTES=1048576

# ── Wire recording (demo scenarios) ──────────────────────────────────────────
# Append one JSON line per WebSocket frame (both directions) and per /api JSON
# response to this file. The raw source of `tools/demo-scenario.mjs`; the file
# holds real roots and tokens, so it is never shared as-is. Unset = zero cost.
# WATERPLANE_WIRE_RECORD=/absolute/private/dir/wire.jsonl  (file is 0600; secrets redacted; 256 MB cap)

# ── Verified capture ─────────────────────────────────────────────────────────
# "Show me what that screen looks like right now, and say how much the picture
# can be trusted": per-repo targets in <repo>/.waterplane/capture.json, driven by a
# browser (Playwright, resolved out of the TARGET repo's node_modules at
# runtime), an Android device over adb, a Garmin simulator through ciqkit, or a
# desktop window. Every frame lands in .claude/outbox/ beside a sidecar JSON,
# and the thing a person or an agent actually reads is the one-line verdict.
# Nothing here is installed for you — a backend you have not set up simply says
# so, in words, when you run a target that needs it.
# Kill switch. Off means `capture.run` and every probe refuse in one sentence;
# nothing else in the host changes.
# WATERPLANE_CAPTURE=0
# The `adb` the android backend shells out to, when it is not on PATH.
# WATERPLANE_ADB_BIN=/Users/you/Library/Android/sdk/platform-tools/adb
# The `ciqkit` binary the garmin backend shells out to (never imported, never
# vendored — it owns its own simulator broker).
# WATERPLANE_CIQKIT_BIN=/Users/you/dev/garmin/ciqkit/bin/ciqkit

# ── Misc ─────────────────────────────────────────────────────────────────────
# Max upload size in bytes (64 MB). The inbox takes any kind of file, so the
# ceiling covers scanned PDFs and archives, not just photos.
# WATERPLANE_MAX_UPLOAD=67108864
# Fan-out: how many repos are started + fed concurrently (each is a real claude
# process, so a 20-repo sweep fired at once would stampede the machine).
# WATERPLANE_FANOUT_CONCURRENCY=6
# "Assess this repo": one headless claude run that reads everything still open
# for a repo and says, per item and WITH evidence, what is already done, what is
# obsolete, what is covered elsewhere and what is still wanted. It reads a whole
# repo and writes two files, so it gets far longer than the per-item reviewers
# (180 s) — the honest bound is how big your repo is, which the daemon cannot
# know. Raise it if big repos come back saying they wrote no assess-out.json.
# WATERPLANE_ASSESS_TIMEOUT_MS=1200000
# The durable Intent store (<state dir>/intents.json): the ONE loop behind every piece
# of deferred work the host owns — a scheduled sweep, and a `session.create` that
# names files it has not got yet and is therefore parked here until the last one
# lands, so a phone with a bad tunnel can hand the whole plan over and close.
# Nothing is armed in advance: every tick re-asks the pure rule, which is what
# makes a restart, a laptop sleep and a DST switch unable to mis-fire anything —
# so this is also how late a fire can be. The events that change an answer (an
# upload landing, a post) kick the tick directly, so it is only the backstop.
# WATERPLANE_INTENT_TICK_MS=2000
# How many AUTOMATIC sessions the host may have alive at once. Every fired work
# item opens a session of its OWN now (a conversation per item: every turn
# re-sends the whole window, so appending unrelated items to one session for ever
# is the shape that made 124 conversations out of 8,968 into 76% of a fortnight's
# tokens — see `sessioncost.ts`). One `claude` is one real process and one real
# share of the account, so this is what stops a host that has been away for a week
# answering a pile of due work by starting a dozen agents inside a minute. It is a
# rung of the ladder rather than a refusal: a row over the cap SAYS it is waiting
# for a slot, and the host closes an idle finished session to make room. Sessions
# you opened with the sheet's own button count too — the cap is about how many
# agents are running, not about who asked for them.
# WATERPLANE_BACKLOG_SESSIONS=3
# How long a finished item's session stays open before it is archived. Not a kill
# and not a `/clear`: it goes to *Recently closed*, reopens with `--continue`, and
# its conversation stays on disk for ever. The ten minutes are for the person who
# walks back to the desk and wants to see what the thing actually did — closing it
# the instant the turn ended would make "open the session" a button that is never
# there when anybody presses it. 0 disables the sweep (the early reap still runs).
# Applies ONLY to sessions set to close when done — the phone's synced setting
# `waterplane.backlog.closeWhenDone` (OFF by default) or the item's own override. A
# session not set to close is closed by nobody but a person, and a full cap then
# waits for them to close one.
# WATERPLANE_BACKLOG_LINGER_MS=600000
# How quiet an automatic session has to have been before it may be closed EARLY to
# free a slot for the next item. The crudest of the three exemptions on purpose:
# attached and holding-a-running-row are facts, while "it stopped printing a minute
# ago" is the only guard there is against closing a session whose agent is between
# two tool calls. A knob because the e2e that pins the reap cannot wait a minute
# three times over; nothing else should set it.
# WATERPLANE_BACKLOG_REAP_IDLE_MS=60000
# Open deliveries: a send whose echo window failed is not a verdict, it is a
# QUESTION the host re-asks against the CLI's own conversation log until it has
# one of the terminal answers (ran / sitting in the composer / never ran).
# Nothing about it needs a client attached. BASE is the first gap and the unit
# the back-off doubles from, MAX_GAP its ceiling, GIVEUP when the host settles
# for "still cannot see" — a row open that long is waiting on a log that does
# not exist, and more sweeps cannot produce one.
# WATERPLANE_SETTLE_BASE_MS=5000
# WATERPLANE_SETTLE_MAX_GAP_MS=180000
# WATERPLANE_SETTLE_GIVEUP_MS=900000
# How many times the host types a provably-absent prompt again. Each attempt is
# authorised by its own fresh "the log is readable and this never ran" verdict,
# so there is never a copy for the next one to stack on; the count is what stops
# a row being re-asked for ever. Four attempts over the doubling gap above keep
# the host trying through the first minute, which is where the answer usually
# is — one attempt made a busy session read as a lost prompt in fifteen seconds.
# WATERPLANE_RESEND_TRIES=4
# Repo setup sweep: the host runs the setup checklist on repos by itself, so a
# repo you never opened in the checklist still gets flagged on its row. Read
# only — it never writes into a repo. Set WATERPLANE_SETUP_WATCH=0 to stop sweeping
# (the checklist sheet still works); SWEEP_MS is how often new repos are looked
# for, RECHECK_MS how stale a verdict may get, SWEEP_BATCH how many repos are
# inspected per pass.
# WATERPLANE_SETUP_WATCH=0
# WATERPLANE_SETUP_SWEEP_MS=600000
# WATERPLANE_SETUP_RECHECK_MS=21600000
# WATERPLANE_SETUP_SWEEP_BATCH=12
# Token/cost metering. Set to 0 to stop recording (history stays readable).
# WATERPLANE_METER=0
# Where host-scoped secrets and config are written. Defaults to
# $XDG_CONFIG_HOME/waterplane, else ~/.config/waterplane.
# WATERPLANE_CONFIG_DIR=/Users/you/.config/waterplane
# Fake HOME the claude CLI's private dir (<home>/.claude) is read from. Only for tests;
# a real `CLAUDE_CONFIG_DIR` (which REPLACES ~/.claude, as the CLI reads it) wins over it and
# is inherited by every spawned claude unchanged.
# WATERPLANE_CLAUDE_HOME=/Users/you
# Skip the boot preflight checks (the e2e scripts set this).
# WATERPLANE_PREFLIGHT=0
# Turn off the edit-time repo guards (scripts/guards/edit-hook.mjs, a Claude Code hook) for a
# session started with this set. The commit and push stages still run them.
# WATERPLANE_EDIT_GUARDS=0
# Seconds scripts/restart.sh waits before kicking the launchd service.
# WATERPLANE_RESTART_DELAY=2
# The one line scripts/restart.sh hands the phone as the restart's reason (default: the
# commit it built, and whether the tree had uncommitted edits).
# WATERPLANE_RESTART_REASON=
# ── Agent context weight ─────────────────────────────────────────────────────
# The repo-setup checklist warns when a repo is expensive to have OPEN: CLAUDE.md
# plus every skill description is re-read on every turn of every session and
# every subagent, so that size is multiplied by everything the repo does. Skill
# BODIES are on-demand and never counted against a repo.
# Measured here once: one CLAUDE.md at 148k chars was 21% of every token that
# repo spent in a week.
# Always-on chars before the row warns (default 16000 ≈ 4k tokens/turn).
# WATERPLANE_CONTEXT_WARN_CHARS=16000
# ...and before it says so loudly (default 40000 ≈ 10k tokens/turn).
# WATERPLANE_CONTEXT_HARD_CHARS=40000
# Skills before their descriptions alone are worth a mention (default 30).
# WATERPLANE_CONTEXT_MAX_SKILLS=30
# These three are this HOST's line. Any repo can be given its own from the Repo
# setup sheet (the "thresholds" control on the context-weight row), which
# outranks them per field and is stored in <state dir>/contextlimits.json —
# never in the repo. A field left unset there keeps inheriting from here.
# Model the per-turn session summary runs on. It is the most-fired claude call
# in the daemon (one per turn-end per session) and needs no repo context, so it
# runs with --setting-sources user --tools "" and its own system prompt.
# WATERPLANE_SUMMARY_MODEL=haiku
# ── Sidecar: WHERE the daemon's unattended completions are bought ────────────
# Three things spend tokens with nobody watching — the per-turn session summary,
# the assessment, and the two reviewers. Each has a routing knob, and each
# DEFAULTS to `claude`, i.e. exactly what this daemon did before the knob
# existed. Engines: `claude` (headless `claude -p`, the default) and
# `openai-compat` (one POST to {baseURL}/chat/completions on a local server —
# ollama, llama.cpp, vLLM — with NO tools).
# Grammar (this file is authoritative):
#   claude | claude-p
#   openai-compat:<baseURL>|<model>     <- exact; use this one
#   openai-compat:<baseURL>:<model>     <- accepted only where it cannot mis-split
# The pipe is the separator because BOTH halves contain colons: the URL has a
# scheme and a port, the model has a tag (`gemma4:e4b`). The colon form is read
# by splitting at the first colon AFTER the URL's path begins, so
# `http://localhost:11434/v1:gemma4:e4b` is right and `http://localhost:11434:m`
# is refused rather than guessed at. An unparseable value is refused in words
# and the call does NOT happen — it never falls back to claude, because not
# spending that token is the only reason to set this.
# The session summary is the most-fired call in the daemon and its contract
# already forbids tools (the transcript is in the prompt), so it is the one that
# can move to a local model. `gemma4:e4b` honours the one-sentence contract in
# ~24 completion tokens; a REASONING model is a poor fit here (one spent 421 of
# 451 tokens thinking and returned nothing).
# WATERPLANE_SIDECAR_SUMMARY=openai-compat:http://localhost:11434/v1|gemma4:e4b
# Assess and review READ a repo and write files, so the toolless local engine is
# refused for them in words rather than run. `claude` is the only value that
# does anything today; the knob exists so a future tool-capable engine has a
# place to be named.
# WATERPLANE_SIDECAR_ASSESS=claude
# WATERPLANE_SIDECAR_REVIEW=claude
# How long a local completion may take (default 120000). Generous on purpose:
# ollama unloads an idle model, so the first call after a quiet spell pays a
# cold load (~15s measured) before it generates anything.
# WATERPLANE_SIDECAR_TIMEOUT_MS=120000
# Completion budget for the local engine (default 2048). Far more than a
# two-sentence summary needs — a tight budget is spent entirely on a reasoning
# model's thinking and yields an empty answer.
# WATERPLANE_SIDECAR_MAX_TOKENS=2048
# The naming pass titles untitled backlog rows. TOOLLESS by contract — it gets
# the items' own words in the prompt and is asked what to CALL them, so it opens
# no file and runs no git — which means the local engine is ALLOWED here, like
# the summary and unlike assess/review. It is also the
# cheapest call this daemon makes, so it is the one most worth moving off the
# account. A reasoning model is a poor fit for the same reason as the summary.
# WATERPLANE_SIDECAR_NAME=claude
# …and the commit-message draft (`host/commitmsg.ts`). Same side of the line
# for the same reason: the diff, the file list and the repo's recent subjects
# are all IN the prompt, it opens no file and runs no git of its own.
# WATERPLANE_SIDECAR_COMMIT=claude
# …and the change brief (`host/changebrief.ts`): commits, stat, diffs and the
# repo's layout are IN the prompt; it runs no git of its own and writes nothing.
# WATERPLANE_SIDECAR_EXPLAIN=claude
# Bearer token for an OpenAI-compatible server that wants one. Ollama does not.
# WATERPLANE_SIDECAR_API_KEY=

# ── Naming: what an untitled backlog row is called ───────────────────────────
# Tapped, never automatic. One toolless pass over the repo's untitled rows
# writes a 3-8 word headline and one of bug/feature/enhancement/chore onto each,
# in batches, and NEVER over a title or a kind you typed yourself.
# Model the pass runs on. The summary's posture: no repo context, so it runs
# with --setting-sources user --tools "" and its own system prompt, plus
# --thinking disabled — titling a sentence is not a problem thinking improves,
# and thinking is the whole of what a pass like this costs.
# WATERPLANE_NAME_MODEL=haiku
# There is deliberately no timeout knob: nothing is held behind this call (no
# item is waiting to fire, no session is blocked), so the sidecar's own generous
# default is right and a second variable would be one nobody has a reason to
# turn. Route the call itself with WATERPLANE_SIDECAR_NAME, above.

# ── Commit messages: the draft the Review sheet's button asks for ────────────
# Tapped, never automatic, and it writes NOTHING — one toolless pass over the
# diff a `Commit all` would record, plus this repo's own last ten commit
# subjects as the house style (the project CLAUDE.md is not loaded, for the
# summary's reason). The answer lands in the commit box for a person to read,
# edit and commit by hand; it never overwrites words already typed there.
# Model the draft runs on. Falls back to WATERPLANE_SUMMARY_MODEL, then haiku.
# WATERPLANE_COMMIT_MODEL=haiku
# How long one draft may take before the answer is "it did not come back". A
# knob here and not on the naming pass because somebody IS waiting on this one,
# looking at the button they just tapped.
# WATERPLANE_COMMIT_TIMEOUT_MS=90000

# ── Change brief: the Review sheet's "Explain" ───────────────────────────────
# Tapped, never automatic, and it writes NOTHING. One toolless pass over what a
# push would send and a pull would bring (commits, stat, diffs — lockfiles and
# .env files left out), explained for a person who does not read code, under
# the focus boxes ticked on the phone (security, user-facing behaviour, which
# components need a deploy, …). Fetches the upstream first so "to pull" is now.
# Model it runs on. Sonnet by default, not haiku: a security reading of a diff
# is the one job here where the cheapest model's misses cost more than the call.
# WATERPLANE_EXPLAIN_MODEL=sonnet
# How long one brief may take. Two diffs of up to 40k characters each.
# WATERPLANE_EXPLAIN_TIMEOUT_MS=170000

# ── Repo-health judgments (`tools/repohealth.mjs judge <event-id>`) ──────────
# The ONLY paid call in the repo-health series; everything else in that tool is
# git, regex and arithmetic. Typed by hand, once, about one event: the command
# prints the input size in chars and tokens and spends nothing without --yes or
# a `y` at a terminal. Unset it and the default model answers, deliberately —
# the cheap callers above pin haiku because their job is tidying prose, while
# this one asks the single question in the tool where a wrong answer is worse
# than no answer. The knob is here for turning it DOWN, per desktop.
# Falls back to WATERPLANE_SUMMARY_MODEL.
# WATERPLANE_JUDGE_MODEL=
# Which ENGINE reads a repo, when the repo has no copy of the tool itself.
# The engine takes `--root=<path>` and derives what a repo is written in, so
# one copy reads every tree — which is the whole reason twelve of the thirteen
# repos here are not a dead end any more. `host/repohealth.ts` resolves, per
# worktree: the worktree's OWN tools/repohealth.mjs first (it is the authority
# on its own root, and it is spawned WITHOUT --root=), else this one. Unset,
# the bundled engine is this checkout's own tools/repohealth.mjs. Set it to an
# ABSOLUTE path to read repos with an engine from somewhere else — a relative
# one would resolve against the daemon's cwd, which under launchd is `/`. It is
# taken as said: a path that is not there is NO engine, never a quiet fallback.
# WATERPLANE_REPOHEALTH_ENGINE=/Users/you/dev/waterplane/tools/repohealth.mjs
# How long ONE step of that engine may run when the PHONE asks for a refresh
# (`host/repohealth.ts`: update → narrate → html, each spawned as its own
# process group). The first run on a repo with no series is a backfill — one
# snapshot per first-parent commit, every blob of every tree read. On THIS repo
# that is 175 first-parent commits in 21.6 s (measured 2026-09-21); minutes is
# true of the FLEET this cap now has to cover — ~/dev/realestatecalc is 1,329
# first-parent commits. Every run after the first is a handful of commits and
# finishes in under a second. Past the cap the process GROUP is killed and the
# phone is told the step was cut, never that the series is broken: whatever was
# already appended is on disk and the next refresh carries on from it. Floored
# at 1000.
# WATERPLANE_REPOHEALTH_TIMEOUT_MS=180000

# ── Local model runner (the runtime strip, `host/localrt.ts`) ────────────────
# Where the local runner's HTTP API lives. Read in one place.
WATERPLANE_OLLAMA_URL=http://127.0.0.1:11434
# Also the ANTHROPIC_BASE_URL a "Claude Code (local model)" session (`claude-local`,
# `host/backends/claude-local.ts`) is launched with, and where its model list and
# context windows are read from. Unreachable => the backend is still listed, saying so.
# A claude-local session launches LEAN: only these built-in tools, and no MCP
# servers (`--tools … --strict-mcp-config`). Measured 2026-10-02 on a 64k
# qwen3-coder: Claude Code's first request fell from 32.4k to 5.7k tokens and a
# one-word turn from 65 s to 5 s (docs/analysis/spikes/2026-10-02-claude-local-lean.md).
# 0 = launch with claude's full tool set. Plain `claude` sessions are never lean.
# WATERPLANE_CLAUDE_LOCAL_LEAN=1
# The tools a lean launch keeps (comma-separated built-in tool names).
# WATERPLANE_CLAUDE_LOCAL_TOOLS=Read,Edit,Write,Bash,Grep,Glob
# On launch, ask Ollama to load the model now and hold it this long (its own
# spelling: 30m, 1h, -1 = for ever). Fire-and-forget: a launch never waits on
# it. Measured: Ollama keeps the last explicit keep_alive for a loaded model,
# so the turns after it do not shrink it back to the server's 5-minute default.
# off = no warm-up ping.
# WATERPLANE_CLAUDE_LOCAL_KEEP_ALIVE=30m
# The local-model gate (`host/localslot.ts`): how many coding sessions on a LOCAL
# model may be WORKING (a turn running) at once. Automatic starts (backlog,
# schedules, agent-posted work, sweep targets) wait as "waiting for the local
# model — 1 local session is working"; a session you start yourself is never
# refused, only told. The phone's Settings → Sessions "local model sessions" row
# overrides this; 0 = no cap. Default 1.
# WATERPLANE_LOCAL_SESSIONS=1
# Before an automatic item opens on a claude-local model, the host loads the model
# on Ollama and waits; a load past this is a held row saying so, retried shortly.
# WATERPLANE_LOCAL_LOAD_TIMEOUT_MS=180000

# ── Claude Code on a custom endpoint (`claude-endpoint`) ─────────────────────
# The real `claude` CLI pointed at any Anthropic-Messages-compatible URL —
# Ollama Cloud, an Ollama on a GPU box in the tailnet, a LiteLLM proxy in front
# of Bedrock/Vertex/Azure models (`host/backends/claude-endpoint.ts`). Unset =>
# the backend is listed as not configured. Its models are always "hosted".
# WATERPLANE_CLAUDE_ENDPOINT_URL=https://ollama.com
# The models to offer, comma-separated, each optionally `=<context tokens>`.
# Unset => asked from the endpoint (Ollama /api/tags, else /v1/models); a window
# is only ever the one written here or the endpoint's own /api/show.
# WATERPLANE_CLAUDE_ENDPOINT_MODELS=qwen3-coder:480b=262144,gpt-oss:120b
# The API key, if the endpoint needs one: a file only you can read (chmod 600 —
# anything looser is refused), or a macOS keychain generic-password service
# (`security add-generic-password -s <service> -a "$USER" -w`). The key never
# goes into a launch's argv or env, a log or the phone: the CLI is handed an
# `apiKeyHelper` command (`cat <file>` / `security find-generic-password -w -s
# <service>`) and reads it itself. A file wins over a keychain service.
# WATERPLANE_CLAUDE_ENDPOINT_KEY_FILE=~/.config/waterplane/endpoint.key
# WATERPLANE_CLAUDE_ENDPOINT_KEYCHAIN=waterplane-endpoint
# 1 = launch lean like claude-local (default off: a big hosted window has room).
# WATERPLANE_CLAUDE_ENDPOINT_LEAN=0
# WATERPLANE_CLAUDE_ENDPOINT_TOOLS=Read,Edit,Write,Bash,Grep,Glob
# Set to 0 to switch the local-runtime poll off entirely on this desktop. The
# phone is then told so in words — "polling is off here" is a different sentence
# from "the runner did not answer", and the two must never collapse.
WATERPLANE_LOCAL_RUNTIME=1
# How often a watched local-runtime sample is taken, ms. The events this catches
# are model load/evict (ollama's keep_alive default is 5 min) and memory
# pressure; neither moves at sub-second speed.
WATERPLANE_LOCALRT_POLL_MS=5000

# ── The local runner's ledger (`host/localusage.ts`, GET /api/localusage) ────
# Compute time, tokens and memory per local model per day, read PASSIVELY:
# ollama's own server log (the runner's print_timing lines + its access line)
# and /api/ps. Never in a request path. Set to 0 to switch it off (the
# local-runtime switch above switches it off too).
WATERPLANE_LOCAL_USAGE=1
# How often /api/ps is sampled and the log's new bytes read, ms. Floored at
# 5000; ×4 while ollama does not answer; the machine's memory is only read
# while a model is resident.
WATERPLANE_LOCAL_USAGE_MS=20000
# Ollama's server log. Default: ~/.ollama/logs/server.log on macOS,
# %LOCALAPPDATA%\Ollama\server.log on Windows; on Linux ollama logs to the
# journal, so name a file it writes or compute time and tokens stay absent
# (memory is still sampled). 0 = do not read it.
# WATERPLANE_OLLAMA_LOG=

# ── The desktop's own numbers (`host/sysstat.ts`) ────────────────────────────
# The CPU split, where the memory went, which programs hold it, temperature and
# fans — sampled inside the local-runtime poll above, so WATERPLANE_LOCAL_RUNTIME=0
# switches these off too.
#
# How often the EXPENSIVE readers actually run, against that 5 s poll: a full
# `ps -A` measured 31 ms over 793 processes, and this daemon pumps every PTY.
# Floored at 5000; the rows carry their own timestamp so a repeat is visibly a
# repeat.
WATERPLANE_SYSSTAT_SLOW_MS=15000
# Set to 0 to stop sending the process list. It names every program running on
# the desktop, which is more than some people want on a phone screen; the
# section then SAYS it was switched off, never that nothing is running.
WATERPLANE_SYSSTAT_PROCS=1
# Temperature and fan speed on macOS: the SMC sensors are root-only
# (`powermetrics` refuses without sudo, and this daemon must never prompt for a
# password), so the reading is ABSENT unless a plugin contributes a thermal
# reader (`api.thermalReader`, docs/plugins-api.md). No knob here. Linux needs
# none of this — /sys/class/thermal and /sys/class/hwmon are read directly.

# ── Your own prices for models Anthropic's list does not name (`host/localledger.ts`) ──
# A JSON file of {"<model id or glob>": {"input": .., "output": .., "cacheRead": .., "cacheWrite": .., "currency": "USD"}},
# per MILLION tokens. Default: prices.json in the per-user config dir (~/.config/waterplane/).
# Only fills a gap — a Claude model on the list is never repriced; no entry ⇒ no cost, said in words.
# WATERPLANE_PRICES=~/.config/waterplane/prices.json

# ── Self-update (`host/cli/selfupdate.ts`) ───────────────────────────────────
# Where `update` and the doctor's self-update row read release.json, the
# tarball and its .sha256, plus the .sig of each (release.json.sig,
# <tarball>.sha256.sig): a URL or a local directory. Default: the GitHub
# release assets (`…/releases/latest/download/`). `update --from` beats this.
# Only an explicit `update` ever downloads; nothing updates on its own.
# WATERPLANE_RELEASE_URL=https://example.com/releases/

# ── Release signing (`scripts/release/build.mjs`, `deploy/install.sh.tmpl`) ──
# Not host knobs. The Ed25519 private key `release:build` signs the .sha256 and
# release.json with (pkcs8 PEM; must match deploy/release-pubkey.pem). Default:
# ~/.config/waterplane-release/release-ed25519.pem. Never in a repo.
# WATERPLANE_RELEASE_KEY=~/.config/waterplane-release/release-ed25519.pem
# The Google service-account JSON key `release:play` publishes to Google Play
# with (scripts/release/play.mjs; setup in packages/app/play/README.md).
# Default: ~/.config/waterplane-release/play-service-account.json. Never in a repo.
# WATERPLANE_PLAY_SA=~/.config/waterplane-release/play-service-account.json
# Read by install.sh AND `update` (and the doctor's self-update row): =1 installs
# a release WITHOUT checking its publisher signature on release.json and the
# tarball's .sha256 (a release you built yourself with --unsigned). Said loudly
# on every run that uses it.
# WATERPLANE_INSECURE_SKIP_SIG=1

# ── Peer desktops (docs/notes/host.md, peers/) ──────────────────────────────
# How often this host polls a paired peer for an open job's state: this many ms
# while the job is running, backing off to 60 s while the peer is unreachable.
# No open jobs, no traffic.
# WATERPLANE_PEER_POLL_MS=5000
# Cap on the text of a peer job's report that comes back as one prompt; the rest
# is cut with a line saying how much and which peer session holds it.
# WATERPLANE_PEER_REPORT_MAX_CHARS=16000

# ── Live desktop (packages/extensions/desktop, macOS) ───────────────────────
# Run this wp-desktop binary as it is instead of building one from
# packages/extensions/desktop/helper into <state dir>/bin/wp-desktop (a prebuilt
# helper). Nothing is built or hashed then. macOS ties Screen Recording and
# Accessibility to the exact binary, so a different file means granting again.
# WATERPLANE_DESKTOP_HELPER=
# Tests only: every helper streams the synthetic test pattern with
# --no-capture --dry-input, so nothing reads the real screen and no click or
# key is posted (scripts/e2e-desktop.mjs). A phone can never choose this.
# WATERPLANE_DESKTOP_SYNTHETIC=0

# ── Dev only (`packages/web/vite.config.ts`) ─────────────────────────────────
# Where `npm run dev`'s Vite proxy sends `/api` and `/ws`. Only the dev server
# reads it — the built bundle is served by the daemon itself and talks to
# whatever origin it was loaded from.
# WATERPLANE_HOST_TARGET=http://127.0.0.1:8770

# ── Tests ───────────────────────────────────────────────────────────────────
# `npm run test:unit`, `test:host` and `scripts/run-e2e.mjs` run with TMPDIR on
# one fresh /tmp/wpt-* dir that is removed at the end (`scripts/with-tmp.mjs`).
# Set to 1 to KEEP that dir when the run fails, to look at what a test left.
# WATERPLANE_KEEP_TEST_TMP=0

# How many e2e scripts `scripts/run-e2e.mjs` runs at once (`--jobs N` wins).
# Default 60% of the cores, capped at 10; 1 runs them one at a time with live output.
# E2E_JOBS=6
# The pool starts no new script while the 1-minute load average is above this
# (one keeps running). Default twice the cores; 0 turns the throttle off.
# E2E_MAX_LOAD=32
# 0 stops reading/writing ~/.cache/waterplane/e2e-times.json, the last run's
# per-script durations the pool uses to start the slowest scripts first.
# E2E_TIMES=1
# 0 stops re-running a failed script once ALONE after the pool (done for up to 3
# failures, so the summary can say "passes alone" or "fails alone too"; either still fails).
# E2E_RETRY_ALONE=1

# Weekly repo-health index: once a week the host re-runs the repo-health engine for
# every repo that already has a series, then pushes one notification if the
# index made an unusual move. Set WATERPLANE_HEALTH_WEEKLY=0 to stop both (the
# chip and the chart still read whatever series exists). SWEEP_MS is how often
# the host checks whether a repo is due.
# WATERPLANE_HEALTH_WEEKLY=0
# WATERPLANE_HEALTH_SWEEP_MS=3600000

# Low-disk push (host/diskwatch.ts): one `disk` notification when the home
# volume drops under this many GB free, and one more under 3 GB; re-armed once
# space is back 2 GB above. On macOS low space makes the OS end apps to clear
# their caches, Tailscale among them. 0 turns it off. Default 10.
# WATERPLANE_DISK_WARN_GB=10

# ── Update check (`host/updates/`) ───────────────────────────────────────────
# The daemon READS (never applies) what is new: waterplane's own release and the plugin repos
# tagged `waterplane-plugin` in the waterplane-dev GitHub org. Once a day, a few minutes after boot,
# and on a tap (10-minute floor; GitHub allows 60 unauthenticated calls an hour).
# 0 switches every check off (the phone's `updates.autoCheck` setting only governs the daily one).
# WATERPLANE_UPDATE_CHECK=0
# Where the check reads from; tests point both at a fake local server.
# WATERPLANE_GITHUB_API=https://api.github.com   # org repo list, topics, releases (unauthenticated)
# WATERPLANE_GITHUB_RAW=https://raw.githubusercontent.com   # each plugin's waterplane-plugin.json
